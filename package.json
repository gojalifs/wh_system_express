{
  "name": "sto-express",
  "version": "1.0.0",
  "description": "Express.js service for STO offline bundle download - reads Laravel file cache or queries SQL Server",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "pm2": "pm2 start ecosystem.config.js",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:ci": "node --experimental-vm-modules node_modules/.bin/jest --ci --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "php-serialize": "^1.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15"
  }
}
