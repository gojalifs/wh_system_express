# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=production
AUTH_TOKEN=supersecret-lan-token

# Material request poller interval (ms)
POLL_INTERVAL_MS=60000

# Laravel file cache path (must be same filesystem as Laravel)
# Default assumes this repo lives alongside Laravel repo
LARAVEL_CACHE_PATH=../storage/framework/cache/data

# SQL Server (same as Laravel .env)
# IMPORTANT: Fill in your actual SQL Server credentials
# The SQL Server must be configured to accept SQL Server Authentication (not just Windows Auth)
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=wh_system
DB_USER=your_sql_username
DB_PASSWORD=your_sql_password
DB_DOMAIN=
DB_OPTIONS_ENCRYPT=false
DB_OPTIONS_TRUST_SERVER_CERTIFICATE=true

# STO bundle database (separate connection)
# Kosongkan nilai STO_DB_* untuk fallback ke konfigurasi DB_* di atas.
STO_DB_HOST=127.0.0.1
STO_DB_PORT=1433
STO_DB_DATABASE=wh_system
STO_DB_USER=your_sto_sql_username
STO_DB_PASSWORD=your_sto_sql_password
STO_DB_OPTIONS_ENCRYPT=false
STO_DB_OPTIONS_TRUST_SERVER_CERTIFICATE=true

# Linked server for wire_tag view (optional)
# The linked server must be configured on SQL Server to accept SQL Server authentication
# (not just Windows Authentication) for wire_tag to work
LINKED_SERVER=192.168.89.218\iGHSSIWSL202
LINKED_DB=iGHS_L2_B3

# Cache key prefix (must match Laravel config/sto.php prefix logic)
CACHE_PREFIX=laravel_cache_

# STO v4 pre-generated bundles (Plan B)
# Shared secret untuk POST /api/v4/sto/internal/prewarm — WAJIB sama persis
# dengan STO_INTERNAL_SECRET di .env Laravel. Kosong = endpoint internal
# nonaktif (503) dan bundle tidak pernah dibangun.
STO_INTERNAL_SECRET=
# Direktori artefak bundle .gz (default: ./storage/sto-bundles)
STO_BUNDLE_DIR=./storage/sto-bundles
# Batas build paralel di runner in-process (dijepit 1..3)
STO_BUILD_CONCURRENCY=2
STO_RUNNER_INTERVAL_MS=2000
# Build RUNNING lebih lama dari ini (menit) dianggap basi dan diantrekan ulang
STO_BUILD_STALE_MINUTES=10

# Logging: debug|info|warn|error (default info).
# Output ke stdout/stderr — rotasi ditangani PM2 (pm2-logrotate).
LOG_LEVEL=info
